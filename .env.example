# Settings for `docker compose` (copy to .env). Every variable is optional.

# Token between the UI proxy and the API; change it if the UI is exposed on a network.
ERENO_API_TOKEN=ereno-local-token
# Where the UI is published on the host
ERENO_UI_BIND=127.0.0.1
ERENO_UI_PORT=5173
# Parallel generations and memory per generation
ERENO_WORKERS=1
ERENO_RUNNER_JVM_ARGS=-Xmx4g
# Recorded in each run's manifest.json (e.g. GIT_COMMIT=$(git rev-parse HEAD))
GIT_COMMIT=

# Firebase login + presets (baked into the UI at build time; empty = local mode)
VITE_AUTH_ENABLED=false
VITE_APIKEY=
VITE_AUTHDOMAIN=
VITE_DATABASEURL=
VITE_PROJECTID=
VITE_STORAGEBUCKET=
VITE_MESSAGINGSENDERID=
VITE_APPID=
VITE_MEASUREMENTID=
