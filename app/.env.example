# Copy to app/.env and fill in what you need. Every variable is optional.

# ERENO API (the backend started by ./dev.ps1 or `java -jar ... serve` in api/)
VITE_API_URL=http://localhost:8080
# Only when the backend runs with ERENO_API_TOKEN set
VITE_API_TOKEN=

# Firebase: Google login and the personal preset library.
# Leave these empty (or set VITE_AUTH_ENABLED=false) to run locally without login.
VITE_AUTH_ENABLED=true
VITE_APIKEY=
VITE_AUTHDOMAIN=
VITE_DATABASEURL=
VITE_PROJECTID=
VITE_STORAGEBUCKET=
VITE_MESSAGINGSENDERID=
VITE_APPID=
VITE_MEASUREMENTID=
